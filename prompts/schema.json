{
  "type": "object",
  "required": ["summary", "terms", "cards", "questions", "dates"],
  "properties": {
    "summary": { "type": "string", "maxLength": 1200 },
    "terms": {
      "type": "array", "minItems": 5, "maxItems": 8,
      "items": { "type": "object", "required": ["word", "definition"],
        "properties": { "word": { "type": "string" }, "definition": { "type": "string" } } }
    },
    "cards": {
      "type": "array", "minItems": 10, "maxItems": 10,
      "items": { "type": "object", "required": ["front", "back"],
        "properties": { "front": { "type": "string" }, "back": { "type": "string" } } }
    },
    "questions": {
      "type": "array", "minItems": 10, "maxItems": 10,
      "items": { "type": "object", "required": ["text", "choices", "correctChoice", "explanation"],
        "properties": {
          "text": { "type": "string" },
          "choices": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "string" } },
          "correctChoice": { "type": "string", "enum": ["A", "B", "C", "D"] },
          "explanation": { "type": "string" } } }
    },
    "dates": {
      "type": "array",
      "items": { "type": "object", "required": ["title", "eventType"],
        "properties": {
          "title": { "type": "string" },
          "dueAt": { "type": "string" },
          "eventType": { "type": "string", "enum": ["sinav", "teslim"] } } }
    }
  }
}
